# Live Trellis sprite (shared deploy target — also used by fractal-playground).
#   sprite:  fractals-demo-0610
#   url:     https://fractals-demo-0610-bnsoz.sprites.app
# Runs the `trellis-db` service (durable TurtleDB room, :8080); the realtime
# relay (/rt WebSocket + /blob content-addressed store) is a second service on
# the same sprite.

# Realtime relay — WebSocket (cross-machine multiplayer). Mesh blob refs
# (trellis-blob:<sha256>) resolve against the same origin via /blob/<hash>.
VITE_RELAY_URL=wss://fractals-demo-0610-bnsoz.sprites.app/rt

# Optional explicit HTTP origin for relay blob GET/PUT (falls back to deriving
# it from VITE_RELAY_URL when unset).
VITE_RELAY_HTTP=https://fractals-demo-0610-bnsoz.sprites.app

# Headless room agent (`pnpm agent:room`) — same WebMCP tools over MCP stdio.
# AGENT_RELAY_URL=wss://fractals-demo-0610-bnsoz.sprites.app/rt
# AGENT_GAME=orbit
# AGENT_ROOM=orbit
# AGENT_CLIENT_ID=bot:architect
# AGENT_NAME=Architect

# WebMCP Chrome origin trial token for production (omit locally — use
# chrome://flags/#enable-webmcp-testing). Register for
# https://trellis-sync-3d-playground.vercel.app
# VITE_WEBMCP_ORIGIN_TRIAL_TOKEN=
