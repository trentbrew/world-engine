{
	"name": "threlte-world-engine",
	"version": "0.1.0",
	"type": "module",
	"engines": {
		"node": ">=20 <24"
	},
	"scripts": {
		"dev": "vite dev",
		"dev:relay": "node scripts/relay.mjs",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"dev:status": "node scripts/dev-status.mjs",
		"test:eav": "tsx --tsconfig .svelte-kit/tsconfig.json scripts/eav-smoke.ts",
		"test:durable": "tsx --tsconfig .svelte-kit/tsconfig.json scripts/durable-smoke.ts",
		"test:player-clip": "tsx --tsconfig .svelte-kit/tsconfig.json scripts/player-clip-smoke.ts",
		"test:player-locomotion": "tsx --tsconfig .svelte-kit/tsconfig.json scripts/player-locomotion-bindings-smoke.ts",
		"test:platform-velocity": "tsx --tsconfig .svelte-kit/tsconfig.json scripts/platform-velocity-smoke.ts",
		"test:player-capsule-fit": "tsx --tsconfig .svelte-kit/tsconfig.json scripts/player-capsule-fit-smoke.ts",
		"test:player-visual-defaults": "tsx scripts/player-visual-defaults-smoke.ts",
		"test:xbot-catalog": "node scripts/xbot-catalog-smoke.mjs",
		"test:character-audit": "node scripts/character-audit-smoke.mjs",
		"assets:audit-characters": "node scripts/audit-characters.mjs",
		"test:world-api": "node scripts/world-api-smoke.mjs",
		"import:sketchfab": "node --env-file=.env scripts/sketchfab-import.mjs",
		"assets:lean-mannequin": "node scripts/lean-mannequin.mjs",
		"test:e2e": "node scripts/test-e2e.mjs",
		"test:e2e:cold": "PW_COLD=1 node scripts/test-e2e.mjs",
		"test:relay-blob": "node scripts/relay-blob-smoke.mjs",
		"test:mesh-ref-blob": "tsx scripts/mesh-ref-blob-smoke.ts",
		"games:catalog": "tsx -e \"import { writeGamesCatalog } from './src/lib/engine/gamesCatalogPlugin.ts'; writeGamesCatalog(process.cwd())\""
	},
	"devDependencies": {
		"@gltf-transform/core": "^4.4.1",
		"@internationalized/date": "^3.12.0",
		"@lucide/svelte": "^1.21.0",
		"@modelcontextprotocol/sdk": "^1.12.1",
		"@playwright/test": "1.52.0",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-vercel": "^6.3.4",
		"@sveltejs/kit": "^2.57.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tanstack/table-core": "^8.21.3",
		"@types/node": "^26.0.0",
		"@types/pngjs": "^6.0.5",
		"embla-carousel-svelte": "^8.6.0",
		"layerchart": "2.0.0-next.48",
		"mode-watcher": "^1.1.0",
		"paneforge": "^1.0.2",
		"pngjs": "^7.0.0",
		"shadcn-svelte": "^1.3.0",
		"svelte": "^5.55.2",
		"svelte-check": "^4.4.6",
		"tsx": "4.19.4",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.2",
		"vaul-svelte": "1.0.0-next.7",
		"vite": "^8.0.7",
		"ws": "^8.21.0"
	},
	"dependencies": {
		"@dimforge/rapier3d-compat": "^0.16.2",
		"@pmndrs/vanilla": "^1.25.0",
		"@sparkjsdev/spark": "^2.1.0",
		"@tailwindcss/vite": "^4.3.1",
		"@threlte/core": "^8.5.16",
		"@threlte/extras": "^9.21.0",
		"@threlte/rapier": "^3.5.0",
		"@types/three": "^0.185.0",
		"bits-ui": "^2.18.1",
		"camera-controls": "^3.1.2",
		"clsx": "^2.1.1",
		"formsnap": "^2.0.1",
		"postprocessing": "^6.39.1",
		"svelte-sonner": "^1.1.1",
		"sveltekit-superforms": "^2.30.1",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.2.2",
		"tailwindcss": "^4.3.1",
		"three": "^0.184.0",
		"three-viewport-gizmo": "2.2.0",
		"trellis": "^3.2.5",
		"zod": "^4.4.3"
	}
}