					"shadowCamSize": 20,
					"shadowNormalBias": 0.02
				},
				"Transform": {
					"position": [
						6,
						9,
						4
					],
					"rotation": [
						0,
						0,
						0,
						1
					],
					"scale": [
						1,
						1,
						1
					]
				}
			}
		},
		{
			"@id": "entity:grass/meadow",
