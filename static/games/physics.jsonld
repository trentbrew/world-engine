{
	"@context": {
		"@vocab": "https://game.example/vocab/",
		"conformsTo": {
			"@type": "@id"
		},
		"components": {
			"@type": "@json"
		}
	},
	"@graph": [
		{
			"@id": "component:Status",
			"@type": "ComponentSchema",
			"fields": {
				"grounded": {
					"t": "boolean",
					"sync": "derived",
					"default": "=Transform.position.y <= 0.55"
				}
			}
		},
		{
			"@id": "type:PhysBox",
			"@type": "EntityType",
			"components": [
				"Transform",
				"Render",
				"Physics",
				"Status"
			],
			"defaults": {
				"Render": {
					"mesh": "primitive:box",
					"color": "#d4d4d4"
				},
				"Physics": {
					"body": "dynamic",
					"collider": "box",
					"mass": 1
				}
			}
		},
		{
			"@id": "type:PhysBall",
			"@type": "EntityType",
			"components": [
				"Transform",
				"Render",
				"Physics",
				"Status"
			],
			"defaults": {
				"Render": {
					"mesh": "primitive:sphere",
					"color": "#5b9fd4"
				},
				"Physics": {
					"body": "dynamic",
					"collider": "ball",
					"mass": 0.6,
					"restitution": 0.85
				}
			}
		},
		{
			"@id": "type:PhysCapsule",
			"@type": "EntityType",
			"components": [
				"Transform",
				"Render",
				"Physics",
				"Status"
			],
			"defaults": {
				"Render": {
					"mesh": "primitive:capsule",
					"color": "#7c6cf0"
				},
				"Physics": {
					"body": "dynamic",
					"collider": "capsule",
					"mass": 0.8
				}
			}
		},
		{
			"@id": "type:Ramp",
			"@type": "EntityType",
			"components": [
				"Transform",
				"Render",
				"Physics"
			],
			"defaults": {
				"Render": {
					"mesh": "primitive:box",
					"color": "#4a5568"
				},
				"Physics": {
					"body": "fixed",
					"collider": "box"
				}
			}
		},
		{
			"@id": "type:StackCrate",
			"@type": "EntityType",
			"components": [
				"Transform",
				"Render",
				"Gravity"
			],
			"defaults": {
				"Render": {
					"mesh": "primitive:box",
					"color": "#e8a838"
				},
				"Gravity": {
					"rest": 0.5
				}
			}
		},
		{
			"@id": "type:PhysBarrel",
			"@type": "EntityType",
			"components": [
				"Transform",
				"Render",
				"Physics",
				"Status"
			],
			"defaults": {
				"Render": {
					"mesh": "/models/barrel.glb"
				},
				"Physics": {
					"body": "dynamic",
					"collider": "hull",
					"mass": 1.2,
					"restitution": 0.1
				}
			}
		},
		{
			"@id": "entity:ground/main",
			"@type": "Thing",
			"conformsTo": "GroundPlane",
			"components": {
				"Ground": {
					"size": 28,
					"color": "#0e0e12"
				},
				"Transform": {
					"position": [
						-0.03780806582746232,
						0,
						-1.4137080851994823
					]
				}
			}
		},
		{
			"@id": "entity:light/ambient",
			"@type": "Thing",
			"conformsTo": "AmbientLight",
			"components": {
				"Light": {
					"intensity": 0.45
				}
			}
		},
		{
			"@id": "entity:light/sun",
			"@type": "Thing",
			"conformsTo": "DirectionalLight",
			"components": {
				"Light": {
					"intensity": 1
				},
				"Transform": {
					"position": {
						"x": 6,
						"y": 12,
						"z": 8
					}
				}
			}
		},
		{
			"@id": "entity:spawn/center",
