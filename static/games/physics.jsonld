					},
					"rotation": {
						"x": 0,
						"y": 0,
						"z": 0.22,
						"w": 0.975
					},
					"scale": [
						4,
						0.4,
						2.5
					]
				}
			}
		},
		{
			"@id": "entity:platform/ledge",
			"@type": "Thing",
			"conformsTo": "Ramp",
			"components": {
				"Transform": {
					"position": {
						"x": 6,
						"y": 2.2,
						"z": 4.5
					},
					"scale": [
						3,
						0.4,
						2
					]
				},
				"Render": {
					"color": "#3a3a44"
				}
			}
		},
		{
			"@id": "entity:phys/box-red",
