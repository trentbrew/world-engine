{
  "@context": {
    "@vocab": "https://game.example/vocab/",
    "conformsTo": { "@type": "@id" },
    "components": { "@type": "@json" },
    "events": { "@type": "@json" }
  },
  "@graph": [
    {
      "@id": "script:bump-score",
      "@type": "Script",
      "title": "Add one point",
      "actions": [{ "score": 1 }]
    },
    {
      "@id": "script:reset-fuses",
      "@type": "Script",
      "title": "Reset all fuses to orange",
      "actions": [
        {
          "with": "Fuse",
          "do": [{ "set": "Render.color", "to": "#ff6600" }]
        }
      ]
    },
    {
      "@id": "script:combo",
      "@type": "Script",
      "title": "Score bump then reset fuses",
      "actions": [{ "script": "script:bump-score" }, { "script": "script:reset-fuses" }]
    },
    {
      "@id": "entity:light/ambient",
      "@type": "Thing",
      "conformsTo": "AmbientLight",
      "components": { "Light": { "intensity": 0.7 } }
    },
    {
      "@id": "entity:ground/main",
      "@type": "Thing",
      "conformsTo": "GroundPlane",
      "components": { "Ground": { "size": 16, "color": "#0e0e14" } }
    },
    {
      "@id": "entity:spawn/start",
      "@type": "Thing",
      "conformsTo": "SpawnPoint",
      "components": { "Transform": { "position": { "x": 0, "y": 0.05, "z": -2 } } }
    },
    {
      "@id": "type:Player",
      "@type": "EntityType",
      "components": ["Transform", "Render", "Player", "Physics", "Jump"],
      "events": {
        "keydown": [
          { "key": "e", "do": [{ "script": "script:bump-score" }] },
          { "key": "r", "do": [{ "script": "script:combo" }] }
        ]
      }
    },
    {
      "@id": "type:Fuse",
      "@type": "EntityType",
      "components": ["Transform", "Render"],
      "defaults": {
        "Render": { "mesh": "primitive:box", "color": "#3498db" }
      }
    },
    {
      "@id": "entity:fuse/1",
      "@type": "Thing",
      "conformsTo": "Fuse",
      "components": { "Transform": { "position": { "x": -2, "y": 0.5, "z": 0 } } }
    },
    {
      "@id": "entity:fuse/2",
      "@type": "Thing",
      "conformsTo": "Fuse",
      "components": { "Transform": { "position": { "x": 0, "y": 0.5, "z": 1.5 } } }
    }
  ]
}
