{
	"@context": {
		"@vocab": "https://game.example/vocab/",
		"conformsTo": { "@type": "@id" },
		"components": { "@type": "@json" }
	},
	"@graph": [
		{
			"@id": "entity:scene/settings",
			"@type": "Thing",
			"conformsTo": "Prop",
			"components": {
				"EditorScene": {
					"document": {
						"v": 1,
						"scene": {
							"displayName": "Terrain",
							"sky": { "enabled": true, "kind": "stylized", "stylizedMode": "day" }
						}
					}
				},
				"Render": { "visible": false },
				"Transform": { "position": [0, -40, 0], "rotation": [0, 0, 0, 1], "scale": [0.01, 0.01, 0.01] }
			}
		},
		{
			"@id": "entity:light/ambient",
			"@type": "Thing",
			"conformsTo": "AmbientLight",
			"components": { "Light": { "intensity": 2.0, "color": "#f5e7c3" } }
		},
		{
			"@id": "entity:light/sun",
			"@type": "Thing",
			"conformsTo": "DirectionalLight",
			"components": {
				"Light": {
					"intensity": 3.0,
					"color": "#ffffff",
					"shadowMapSize": 4096,
					"shadowCamSize": 34,
					"shadowNormalBias": 0.22
				},
				"Transform": { "position": [-37, 14, -8], "rotation": [0, 0, 0, 1], "scale": [1, 1, 1] }
			}
		},
		{
			"@id": "entity:terrain/valley",
			"@type": "Thing",
			"conformsTo": "Terrain",
			"components": {
				"Terrain": {
					"size": 60,
					"segments": 128,
					"heightScale": 5,
					"baseHeight": -0.6,
					"noiseScale": 0.045,
					"octaves": 4,
					"seed": 4242,
					"colorLow": "#33553a",
					"colorHigh": "#8a9a54",
					"grass": {
						"enabled": true,
						"density": 160,
						"maxCount": 30000,
						"bladeMinLength": 0.12,
						"bladeMaxLength": 0.32,
						"windStrength": 0.12,
						"windDirection": 243,
						"flowers": true,
						"params": { "flMaxCount": 1200, "flSize": 0.4 }
					}
				},
				"Transform": { "position": [0, 0, 0], "rotation": [0, 0, 0, 1], "scale": [1, 1, 1] }
			}
		},
		{
			"@id": "entity:water/sea",
			"@type": "Thing",
			"conformsTo": "WaterSurface",
			"components": {
				"Water": {
					"size": 60,
					"params": {
						"scale": 0.5,
						"cellSpeed": 0.9,
						"noiseScale": 1.0,
						"deepColor": "#1f6fa8",
						"midColor": "#5ec6ee",
						"opacity": 0.85,
						"deepOpacity": 0.4
					}
				},
				"Transform": { "position": [0, -1.1, 0], "rotation": [0, 0, 0, 1], "scale": [1, 1, 1] }
			}
		},
		{
			"@id": "entity:spawn/ridge",
			"@type": "Thing",
			"conformsTo": "SpawnPoint",
			"components": { "Transform": { "position": [0, 5.6, -8], "rotation": [0, 0, 0, 1], "scale": [1, 1, 1] } }
		}
	]
}
