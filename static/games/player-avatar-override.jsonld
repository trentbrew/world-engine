{
	"@context": {
		"@vocab": "https://game.example/vocab/",
		"conformsTo": {
			"@type": "@id"
		},
		"components": {
			"@type": "@json"
		}
	},
	"@graph": [
		{
			"@id": "type:Player",
			"@type": "EntityType",
			"components": [
				"Transform",
				"SkinnedMesh",
				"Mesh3DAnimator",
				"Player",
				"Physics",
				"Jump"
			],
			"defaults": {
				"SkinnedMesh": {
					"mesh": "/models/player.glb",
					"anchor": "bottom",
					"rig": "human",
					"forwardYaw": 0,
					"capsuleRadiusScale": 1,
					"capsuleHeightScale": 1
				},
				"Mesh3DAnimator": {
					"catalog": "catalog:mesh2motion-human",
					"clip": "Idle_Loop",
					"speed": 1,
					"loop": true,
					"rootMotion": false,
					"playing": true
				},
				"Physics": {
					"body": "kinematicPosition",
					"collider": "capsule",
					"mass": 70,
					"gravityScale": 0
				},
				"Jump": {}
			}
		},
		{
			"@id": "entity:ground/main",
			"@type": "Thing",
			"conformsTo": "GroundPlane",
			"components": {
				"Ground": {
					"size": 20,
					"color": "#00000000"
				},
				"Transform": {
					"position": [0, 0, 0]
				}
			}
		},
		{
			"@id": "entity:light/ambient",
			"@type": "Thing",
			"conformsTo": "AmbientLight",
			"components": {
				"Light": {
					"intensity": 0.6
				}
			}
		},
		{
			"@id": "entity:light/sun",
			"@type": "Thing",
			"conformsTo": "DirectionalLight",
			"components": {
				"Light": {
					"intensity": 0.9
				},
				"Transform": {
					"position": {
						"x": 4,
						"y": 8,
						"z": 6
					}
				}
			}
		},
		{
			"@id": "entity:spawn/center",
			"@type": "Thing",
			"conformsTo": "SpawnPoint",
			"components": {
				"Transform": {
					"position": {
						"x": 0,
						"y": 0,
						"z": 0
					}
				},
				"Marker": {
					"kind": "spawn"
				}
			}
		}
	]
}
