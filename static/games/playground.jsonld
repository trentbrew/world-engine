{
  "@context": {
    "@vocab": "https://game.example/vocab/",
    "conformsTo": { "@type": "@id" },
    "components": { "@type": "@json" }
  },
  "@graph": [
    {
      "@id": "component:Status",
      "@type": "ComponentSchema",
      "fields": {
        "grounded": { "t": "boolean", "sync": "derived", "default": "=Transform.position.y <= 0.55" }
      }
    },
    {
      "@id": "type:Crate",
      "@type": "EntityType",
      "components": ["Transform", "Render", "Physics", "Status"],
      "defaults": { "Physics": { "body": "dynamic", "collider": "box" } }
    },

    {
      "@id": "entity:ground/main",
      "@type": "Thing",
      "conformsTo": "GroundPlane",
      "components": { "Ground": { "size": 24 } }
    },
    {
      "@id": "entity:light/ambient",
      "@type": "Thing",
      "conformsTo": "AmbientLight",
      "components": { "Light": { "intensity": 0.4 } }
    },
    {
      "@id": "entity:light/sun",
      "@type": "Thing",
      "conformsTo": "DirectionalLight",
      "components": {
        "Light": { "intensity": "=1.1 + sin(t * 1.5) * 0.5" },
        "Transform": { "position": { "x": 6, "y": 9, "z": 6 } }
      }
    },
    {
      "@id": "entity:spawn/center",
      "@type": "Thing",
      "conformsTo": "SpawnPoint",
      "components": { "Transform": { "position": { "x": 0, "y": 0.05, "z": 0 } } }
    },

    {
      "@id": "entity:crate/red",
      "@type": "Thing",
      "conformsTo": "Crate",
      "components": {
        "Transform": { "position": { "x": -2, "y": 6, "z": -1 } },
        "Render": { "color": "#ff6b6b" },
        "Physics": { "mass": 1 }
      }
    },
    {
      "@id": "entity:crate/blue",
      "@type": "Thing",
      "conformsTo": "Crate",
      "components": {
        "Transform": { "position": { "x": 0, "y": 4, "z": 1.5 } },
        "Render": { "color": "#5b9fd4" },
        "Physics": { "mass": 1 }
      }
    },
    {
      "@id": "entity:crate/gold",
      "@type": "Thing",
      "conformsTo": "Crate",
      "components": {
        "Transform": { "position": { "x": 2.2, "y": 8, "z": -0.5 } },
        "Render": { "color": "#e8a838" },
        "Physics": { "mass": 1 }
      }
    },
    {
      "@id": "entity:prop/pillar",
      "@type": "Thing",
      "conformsTo": "Prop",
      "components": {
        "Transform": { "position": { "x": -4, "y": 0.5, "z": 3 } },
        "Render": { "mesh": "/models/barrel.glb", "anchor": "bottom" }
      }
    }
  ]
}
